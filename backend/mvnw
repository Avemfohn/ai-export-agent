# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
#
# Optional ENV vars
# -----------------
#   JAVA_HOME - location of a JDK home dir, required when download maven via java source
#   MVNW_REPOURL - repo url base for downloading maven distribution
#   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
#   MVNW_VERBOSE - true: enable verbose log; debug: trace the mvnw script; others: silence the output
# ----------------------------------------------------------------------------

set -e
if [ "$MVNW_VERBOSE" = debug ]; then
  set -x
fi

if [ -z "$JAVA_HOME" ]; then
  javaExecutable="$(command -v javac)"
  if [ -n "$javaExecutable" ] && ! [ "$(expr "$javaExecutable" : '\([^ ]*\)')" = "no" ]; then
    javaHome="$(dirname "$javaExecutable")"
    javaHome=$(cd "$javaHome" && cd .. && pwd)
    JAVA_HOME="$javaHome"
    export JAVA_HOME
  fi
fi

if [ -z "$JAVA_HOME" ]; then
  if [ -x "/usr/libexec/java_home" ]; then
    JAVA_HOME="$(/usr/libexec/java_home)"; export JAVA_HOME
  else
    echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    exit 1
  fi
fi

# traverses directory structure from process work directory to filesystem root
# first directory with .mvn subdirectory is considered project base directory
find_maven_basedir() {
  if [ -z "$1" ]; then
    echo "Path not specified to find_maven_basedir"
    return 1
  fi

  basedir="$1"
  wdir="$1"
  while [ "$wdir" != '/' ]; do
    if [ -d "$wdir"/.mvn ]; then
      basedir=$wdir
      break
    fi
    # workaround for JBEAP-8937 (on Solaris 10/Sparc)
    if [ -d "${wdir}" ]; then
      wdir=$(cd "$wdir/.." || exit 1; pwd)
    fi
  done
  printf '%s' "$(cd "$basedir" || exit 1; pwd)"
}

# concatenates all lines of a file
concat_lines() {
  if [ -f "$1" ]; then
    printf '%s\n' "$(tr -s '\r\n' ' ' < "$1")"
  fi
}

BASE_DIR=$(find_maven_basedir "$(dirname "$0")")
if [ -z "$BASE_DIR" ]; then
  exit 1
fi

MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}; export MAVEN_PROJECTBASEDIR
# For Cygwin, switch paths to Windows format before running java
if command -v cygpath >/dev/null 2>&1; then
  [ -n "$MAVEN_PROJECTBASEDIR" ] &&
    MAVEN_PROJECTBASEDIR=$(cygpath --path --windows "$MAVEN_PROJECTBASEDIR")
  [ -n "$JAVA_HOME" ] &&
    JAVA_HOME=$(cygpath --path --windows "$JAVA_HOME")
fi

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"

wrapperPropertiesPath="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
if [ -f "$wrapperPropertiesPath" ]; then
  wrapperUrlProperty=$(grep "^wrapperUrl" "$wrapperPropertiesPath" | tr -d '\r')
  wrapperUrl=${wrapperUrlProperty#wrapperUrl=}
  if [ -n "$wrapperUrl" ]; then
    WRAPPER_URL="$wrapperUrl"
  fi
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  if [ "$MVNW_VERBOSE" = true ]; then
    echo "Couldn't find $WRAPPER_JAR, downloading it ..."
    echo "Downloading from: $WRAPPER_URL"
  fi

  if command -v wget >/dev/null 2>&1; then
    [ "$MVNW_VERBOSE" = true ] && QUIET_OPT="" || QUIET_OPT="--quiet"
    wget $QUIET_OPT "$WRAPPER_URL" -O "$WRAPPER_JAR" || rm -f "$WRAPPER_JAR"
  elif command -v curl >/dev/null 2>&1; then
    [ "$MVNW_VERBOSE" = true ] && QUIET_OPT="" || QUIET_OPT="--silent"
    curl $QUIET_OPT -o "$WRAPPER_JAR" "$WRAPPER_URL" -f -L || rm -f "$WRAPPER_JAR"
  else
    echo "Error: unable to download maven-wrapper.jar - neither wget nor curl is available." >&2
    exit 1
  fi
fi

MAVEN_OPTS="$(concat_lines "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config") $MAVEN_OPTS"

exec "$JAVA_HOME/bin/java" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
  $WRAPPER_LAUNCHER "$@"
